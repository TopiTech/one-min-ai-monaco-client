# 1min.ai API key. Never put this in public frontend code.
ONE_MIN_AI_API_KEY=your_1min_ai_api_key_here

# Server configuration
PORT=3000
# NODE_ENV: "development" (default) enables stack traces in error responses.
# Set to "production" for public-facing deployments.
NODE_ENV=development

# File upload limits (in bytes or b/kb/mb/gb suffix, default: 25MB)
# Range: 1 - 100MB (104857600 bytes)
MAX_FILE_SIZE=26214400

# JSON body size limit (b/kb/mb/gb suffix, default: 2mb)
MAX_JSON_BODY_SIZE=2mb

# API settings
# API_TIMEOUT: Upstream request timeout in ms. Range: 1000 - 600000 (10 min)
API_TIMEOUT=60000
# API_RETRYAttempts: Number of retries for idempotent requests. Range: 0 - 10
API_RETRY_ATTEMPTS=3
# API_RETRY_DELAY: Base delay between retries in ms. Range: 0 - 600000
API_RETRY_DELAY=2000

# Override 1min.ai API base URL (for mock servers or staging)
# ONE_MIN_AI_API_BASE_URL=https://api.1min.ai

# Asset proxy guardrails
# Timeout for fetching remote 1min.ai/S3 assets through the local proxy (ms)
# Range: 1000 - 300000 (5 min)
ASSET_PROXY_TIMEOUT_MS=30000
# Maximum proxied asset response size (bytes or b/kb/mb/gb suffix, default: 50MB)
# Range: 1 - 100MB (104857600 bytes)
ASSET_PROXY_MAX_SIZE=50mb

# Default models
DEFAULT_CHAT_MODEL=gpt-4o-mini
DEFAULT_CODE_MODEL=qwen3-coder-plus
DEFAULT_IMAGE_MODEL=gpt-image-2
DEFAULT_IMAGE_EDITOR_MODEL=gpt-image-2

# Rate limiting (per window)
# RATE_LIMIT_WINDOW_MS: Window duration in ms. Range: 1000 - 86400000 (24h)
RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX: Max requests per window (global). Range: 1 - 100000
RATE_LIMIT_MAX=180
RATE_LIMIT_AUTOCOMPLETE_MAX=600
RATE_LIMIT_CHAT_MAX=300

# Session TTL for agent sessions (ms)
# Range: 60000 (1 min) - 86400000 (24h)
SESSION_TTL_MS=1800000

# Workspace and agent settings
# ALLOWED_ROOTS: Comma-separated absolute paths for additional allowed directories.
# Example: ALLOWED_ROOTS=C:\Users\Documents\projects,D:\work
# If empty, only PROJECT_ROOT (this project directory) is allowed.
ALLOWED_ROOTS=
ENABLE_COMMAND_EXECUTION=false
# ENABLE_CODE_RUN: Enable the /api/code/run endpoint for direct code execution
# from the editor (runs arbitrary node/python code without agent approval flow).
# Default: false. Must be explicitly enabled.
ENABLE_CODE_RUN=false
# COMMAND_TIMEOUT_MS: Timeout for command execution in ms. Range: 1000 - 600000 (10 min)
COMMAND_TIMEOUT_MS=30000
# MAX_COMMAND_OUTPUT_SIZE: Maximum captured stdout/stderr buffer size in bytes or b/kb/mb/gb suffix (default: 10mb)
MAX_COMMAND_OUTPUT_SIZE=10mb
AGENT_AUTO_APPROVE=false
# ALLOW_UNSAFE_AGENT_AUTO_APPROVE: Must be explicitly set to true only in a fully isolated sandbox
# (Docker, VM, disposable workspace) when ENABLE_COMMAND_EXECUTION=true and AGENT_AUTO_APPROVE=true.
# Without this override, the server refuses to start with that dangerous combination.
# ALLOW_UNSAFE_AGENT_AUTO_APPROVE=false
# AGENT_MAX_LOOPS: Maximum number of agent loop iterations (1-100, default: 20).
AGENT_MAX_LOOPS=20
# AGENT_MAX_SESSIONS: Maximum number of agent sessions held in memory (1-1000, default: 50).
# When exceeded, the oldest idle session is evicted. Running sessions are never evicted.
# AGENT_MAX_SESSIONS=50
# AGENT_MAX_PENDING_COMMANDS: Maximum number of pending (un-approved) agent commands
# kept in memory. Excess oldest entries are dropped (1-10000, default: 100).
# AGENT_MAX_PENDING_COMMANDS=100
# AGENT_MAX_HISTORY_ENTRIES: Maximum number of history entries per agent session
# before oldest entries are trimmed (1-500, default: 50).
# AGENT_MAX_HISTORY_ENTRIES=50
# AGENT_MAX_HISTORY_RESULT_SIZE: Maximum captured stdout/stderr size per history
# entry in characters (100-1000000, default: 2000).
# AGENT_MAX_HISTORY_RESULT_SIZE=2000
# AGENT_ZOMBIE_GRACE_MS: Grace period after command timeout before a "running"
# session is force-reset to idle (0-86400000, default: 60000).
# AGENT_ZOMBIE_GRACE_MS=60000
# AGENT_MAX_READ_SIZE: Maximum file size the agent can read in a single
# /sessions/:id/files request in bytes (1024-104857600, default: 10MB).
# AGENT_MAX_READ_SIZE=10485760
# AGENT_TMP_FILE_MAX_AGE_MS: Age (in ms) at which orphaned .tmp files inside
# .mimocode/data are removed by the periodic cleanup (60000-86400000, default: 1800000).
# AGENT_TMP_FILE_MAX_AGE_MS=1800000
# FS_MAX_LIST_ENTRIES: Maximum directory entries returned by /api/fs/list
# before being marked truncated (100-100000, default: 5000).
# FS_MAX_LIST_ENTRIES=5000
# FS_MAX_DELETE_ENTRIES: Maximum total entries a recursive /api/fs/delete
# will accept before refusing (10-100000, default: 1000).
# FS_MAX_DELETE_ENTRIES=1000
# ENABLE_DRIVES_SHELL_LOOKUP: Reserved (currently unused — drives are enumerated
# without spawning a shell). (default: true).
# ENABLE_DRIVES_SHELL_LOOKUP=true

# Local BFF authentication
# LOCAL_BFF_AUTH_TOKEN: Fixed token for local BFF auth. If unset, a random token is
# generated on first start and persisted to .mimocode/data/bff_session.token so
# sessions survive restarts. Delete that file to force a new token on the next start.
# LOCAL_BFF_AUTH_TOKEN=your-secret-token

# Allowed extra commands (comma-separated list of commands to dynamically opt-in, e.g. "npx,pip,pipenv")
# ALLOWED_EXTRA_COMMANDS=

# Logging
LOG_LEVEL=info
# Set to "true" to also write logs to logs/app-YYYY-MM-DD.log (auto-created).
LOG_TO_FILE=false
# LOG_FILE: Custom log file path (default: logs/app.log).
# LOG_FILE=logs/app.log

# CORS
# ALLOWED_CORS_ORIGINS: Comma-separated list of additional allowed origins (besides localhost/127.0.0.1).
# Example: ALLOWED_CORS_ORIGINS=https://mydomain.example.com,http://localhost:8080
ALLOWED_CORS_ORIGINS=
