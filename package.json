{
  "name": "one-min-ai-monaco-client",
  "version": "1.0.0",
  "description": "Browser AI client using Monaco Editor + custom UI + 1min.ai API proxy",
  "type": "module",
  "scripts": {
    "copy-monaco": "node scripts/copy-monaco.js",
    "copy-vendor": "node scripts/copy-vendor.js",
    "start": "node scripts/copy-vendor.js && node scripts/copy-monaco.js && node server.js",
    "dev": "node scripts/copy-vendor.js && node scripts/copy-monaco.js && node --watch server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"server.js\" \"eslint.config.js\" \"{public,routes,utils,config,services,providers,middlewares,scripts,mobile,tests}/**/*.{js,css,html}\"",
    "format:check": "prettier --check \"server.js\" \"eslint.config.js\" \"{public,routes,utils,config,services,providers,middlewares,scripts,mobile,tests}/**/*.{js,css,html}\"",
    "type-check": "tsc --noEmit",
    "android:prepare": "node scripts/android-prepare.js",
    "android:sync": "node scripts/android-prepare.js && npx cap sync android",
    "android:build": "node scripts/android-prepare.js && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "cookie": "^2.0.1",
    "dompurify": "^3.4.15",
    "dotenv": "^18.0.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "js-tiktoken": "^1.0.21",
    "marked": "^18.0.14",
    "monaco-editor": "^0.57.0",
    "multer": "^2.5.0",
    "zod": "^4.6.5"
  },
  "overrides": {
    "dompurify": "^3.4.15",
    "ip-address": "^10.7.0",
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "./tests/setup-env.cjs"
    ],
    "transform": {},
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/android/"
    ],
    "coveragePathIgnorePatterns": [
      "<rootDir>/public/js/",
      "<rootDir>/scripts/"
    ],
    "maxWorkers": 2,
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  }
}
